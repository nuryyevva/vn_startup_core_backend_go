# Copy this file to .env and adjust values for your environment.
# Every environment variable used anywhere in the project is listed here —
# internal/config/config.go is the only place that reads them.

# --- Server ---
# TCP port the HTTP API listens on.
SERVER_PORT=8080
# Deployment environment: development|staging|production. Affects log format and defaults.
APP_ENV=development

# --- Postgres ---
# Postgres host.
POSTGRES_HOST=localhost
# Postgres port.
POSTGRES_PORT=5432
# Postgres user (required, no default).
POSTGRES_USER=vn_platform
# Postgres password (required, no default).
POSTGRES_PASSWORD=vn_platform_dev_password
# Postgres database name.
POSTGRES_DB=vn_platform
# Postgres SSL mode (disable for local dev, require/verify-full in production).
POSTGRES_SSLMODE=disable
# Maximum number of connections in the pgx connection pool.
POSTGRES_MAX_CONNS=20

# --- Redis ---
# Redis address, host:port.
REDIS_ADDR=localhost:6379
# Redis password, empty if auth is disabled.
REDIS_PASSWORD=
# Redis logical database index.
REDIS_DB=0

# --- NATS ---
# NATS server URL (JetStream must be enabled on the server, e.g. `nats-server -js`).
NATS_URL=nats://localhost:4222

# --- JWT ---
# Secret used to sign access/refresh tokens (required, at least 16 chars). Generate a strong random value in production.
JWT_SECRET=change-me-to-a-long-random-secret-value
# Access token lifetime (Go duration string).
JWT_ACCESS_TTL=15m
# Refresh token lifetime (Go duration string).
JWT_REFRESH_TTL=720h

# --- Dialog / free-dialog sessions ---
# How often the session scheduler scans for expired time-limited dialog sessions.
DIALOG_SESSION_CHECK_INTERVAL=10s
# Default diamond cost of a single free-dialog message when a scene doesn't override it.
DIALOG_DEFAULT_MESSAGE_COST=20

# --- Dev-only ---
# Enables the /dev/wallet/grant endpoint used to manually credit diamonds instead of real payments.
# Must be false in production.
ENABLE_DEV_ENDPOINTS=true
